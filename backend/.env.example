# Cấu hình backend. Không lưu mật khẩu giảng viên hay token phiên thi tại đây.
# Tạo tài khoản: python backend\create_teacher.py GV-2026 "Họ tên giảng viên".
# Mặc định không chấp nhận PROCTOR_API_TOKEN; chỉ bật cho dự phòng quản trị.
ALLOW_LEGACY_TOKEN=0
# Regex mã sinh viên; mặc định đúng dạng SV- và 8 đến 12 chữ số.
STUDENT_ID_REGEX=^SV-\d{8,12}$
# PROCTOR_API_TOKEN=<admin-token>

# Danh sách origin tùy chọn, phân tách bằng dấu phẩy.
# ALLOWED_ORIGINS=http://localhost:5173,https://exam.example.edu
# Bỏ qua lưu ảnh khi tổng dung lượng snapshots vượt ngưỡng này (byte, mặc định 2 GiB).
MAX_SNAPSHOTS_STORAGE_BYTES=2147483648
